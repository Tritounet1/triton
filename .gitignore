# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Node (racine : script "start"/"dev" avec concurrently)
node_modules/

# Virtual environments
.venv

# Secrets
.env

# Self plan for the app
PLAN.md

# Working audit notes are local progress tracking, not project source.
AUDIT.md

# Historique de conversation persistant (donnees locales, pas versionnees)
sessions/

# Logs d'observabilite (donnees locales, pas versionnees)
logs/

# Memoire persistante du tool remember : globale (partagee par toutes les
# conversations, actuellement vide - infrastructure posee pour plus tard),
# par projet (project_memory/<id>.md) et par conversation sans projet
# (sessions/<id>.memory.md, deja couvert par l'entree sessions/ ci-dessus)
# - donnees locales, pas versionnees
memory_global.md
project_memory/

# Config des serveurs MCP (contient souvent des cles API en clair, comme
# claude_desktop_config.json : jamais versionne)
mcp_servers.json

# Projets (dossiers locaux de la machine, pas versionnes)
projects.json

# Preferences locales (modele choisi, etc.)
settings.json

# Taches recurrentes (prompts programmes) - donnees locales, pas versionnees
scheduled_tasks.json

# Etat des taches en arriere-plan (pid, logs) - donnees locales, pas versionnees
background_tasks_state/

# Filet de securite ecriture : quelle session a un snapshot et ou (json),
# le store de blobs adresses par contenu et les manifestes (format actuel,
# voir triton/tools/snapshot.py), et les anciennes copies de sauvegarde
# (format "copy" legacy, pour les projets qui n'etaient pas des repos git)
# - donnees locales, pas versionnees
snapshots.json
snapshot_backups/
snapshot_objects/
snapshot_manifests/

# Runs multi-agents en cours (persistes pour survivre a un redemarrage du
# harness - voir orchestrator.resume_incomplete_runs()) - supprime des
# qu'un run se termine, donnees locales et ephemeres, pas versionnees
orchestrator_runs/
